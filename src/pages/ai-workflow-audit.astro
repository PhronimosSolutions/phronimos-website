---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  AUDIT_CREDIT_NOTE,
  AUDIT_HEADLINE_ONE_LINER,
  AUDIT_NAME,
  BOOKING_URL,
  CONTACT_EMAIL,
  PRICE_AUDIT,
  PRICE_AUDIT_VALUE,
  PRICE_SPRINT,
  SITE_URL,
} from '../config';

// Category-anchor page. URL and H1 preserved for SERP continuity — "AI workflow
// audit" is the search phrase, "Agent Reliability Review" is the offer we
// actually deliver. The body has been rewritten around the four silent-failure
// modes and the credit-forward mechanic. Structure follows the same
// extraction-friendly pattern: question-shaped H2s, answer under each, a
// comparison table, and prices stated in prose.

// The four silent-failure modes — the diagnostic scaffold the review runs
// against. Text mirrors delivery-operating-kit/05-report-build-checklist.md,
// abbreviated for a web page and paired with the monitoring shape that
// catches each one going forward.
const failureModes = [
  {
    id: 'SFM-1',
    name: 'Bad or empty output on a green status code.',
    what: 'The workflow executes successfully — the API returned 200, the log line says complete — and the output is wrong, blank, malformed, or nonsense. Downstream systems accept it because the status was fine. Nobody catches it until a human notices the consequence days later.',
    monitor: 'Per-workflow output-shape validation on every run — required sections non-empty, field types correct, size within band.',
  },
  {
    id: 'SFM-2',
    name: 'Webhook silently stops receiving events.',
    what: 'The listener is up. The sender changed. Auth token expired, endpoint URL rotated, source API deprecated the event, rate limit tripped and the sender gave up. The workflow keeps polling a queue that stays empty and reports "nothing to do" indefinitely.',
    monitor: 'Per-source webhook delivery-rate alert against a rolling baseline.',
  },
  {
    id: 'SFM-3',
    name: 'Workflow hasn\'t executed in an unusually long time.',
    what: 'The trigger stopped firing. A cron was disabled during a deploy and never re-enabled. Zapier task limit hit and the client didn\'t get the email. Scheduled job\'s parent workflow was deleted. Absence-of-runs looks the same as no-work-to-do, so nobody notices.',
    monitor: 'Per-workflow "last successful run" freshness alert with an SLA window per workflow class.',
  },
  {
    id: 'SFM-4',
    name: 'Downstream system stops receiving expected data.',
    what: 'The workflow runs. The output looks fine on our side. The downstream system doesn\'t see it. API contract changed, destination account was suspended, integration credential rotated on the receiving side, spam filter ate the email, folder permission removed write access.',
    monitor: 'Per-destination downstream-received confirmation loop closing the round trip.',
  },
];

const includes = [
  ['45-minute working call', 'Whoever owns the workflows walks through what is running, what it is supposed to do, and where it has hurt recently.'],
  ['Diagnostic against the four modes', 'Every workflow in scope is run against the four silent-failure modes above, with evidence pulled from logs, run history, and downstream systems.'],
  ['Per-workflow findings', `Each finding cites its failure mode, its blast radius in dollars or hours, and its evidence. 3–7 findings per report; no filler.`],
  ['Remediation plan', 'Every finding gets a fix with an hours-of-effort estimate. Some fixes are free (config change). Some are sprint-shaped (rebuild).'],
  ['Monitoring posture', 'A one-page recommendation for what to instrument on each workflow so the next failure trips an alert on your side, or ours, before your customer sees it.'],
  ['30-minute review call', 'The report walked through live, with questions answered and the next decision named.'],
];

const remediationPaths = [
  ['Configuration only', 'A wrong field, a missing validator, a stale credential. Fixed inside the review window at no extra cost, or handed to your team as a change ticket.'],
  ['Instrumentation', 'The workflow is fine; the monitoring is not. Ships as part of the monitoring posture recommendation. Implementable by your team or scoped as a small sprint.'],
  ['Sprint-shaped rebuild', 'The workflow has a design problem the monitoring cannot mask. Scoped as an Agent Implementation Sprint from $3,500, with the review fee credited toward it.'],
  ['Retire', 'The workflow is not worth fixing. Named plainly in the report, with the alternative — a manual SOP, a different tool, no automation at all — set out for you.'],
];

const faqs = [
  {
    q: 'What is an AI workflow audit?',
    a: 'An AI workflow audit is a paid diagnostic engagement that examines the AI agents, workflows, and automations a business has already deployed and determines whether they are still doing what they were built to do. The Phronimos version — sold as the Agent Reliability Review — maps every finding to one of four silent-failure modes and ends in a written report: findings with evidence, remediation with hours-of-effort per fix, and a monitoring posture so the next failure gets caught before your customer sees it.',
  },
  {
    q: 'How much does an AI workflow audit cost?',
    a: `The Phronimos AI Workflow Audit — sold as the ${AUDIT_NAME} — costs ${PRICE_AUDIT} as a flat fee, agreed before the work starts and not dependent on how many systems are in scope. The fee is credited in full toward an Agent Implementation Sprint or the first month of a Fractional AI Officer retainer, so for anyone who goes on to build, the diagnosis is effectively free.`,
  },
  {
    q: 'How long does an AI workflow audit take?',
    a: 'About two weeks from kickoff to the review call. Your time in: a 45-minute working call at the start, credential access handoff, and a 30-minute review call at the end — roughly 90 minutes total. The review itself happens on our side.',
  },
  {
    q: 'What do I get at the end of an AI workflow audit?',
    a: 'A written findings report with 3–7 findings mapped to the four silent-failure modes, evidence per finding, blast-radius numbers, a remediation plan with hours-of-effort per fix, and a monitoring posture recommendation. Plus a redacted sample so you know the shape before you commit — see the sample incident report on the reliability page.',
  },
  {
    q: 'What happens after the review?',
    a: `Findings sort into four buckets: configuration-only fixes, instrumentation (added monitoring), sprint-shaped rebuilds, and retirements. Configuration fixes usually land inside the review window at no extra cost. Sprint-shaped work is scoped as an Agent Implementation Sprint from ${PRICE_SPRINT}, with the ${PRICE_AUDIT} review fee credited toward it. Some findings are best fixed by your team with the monitoring posture in hand — the report is yours to use either way.`,
  },
  {
    q: 'Why pay for a review instead of taking a free consultation?',
    a: `A free consultation ends in a conversation. A paid review ends in a diagnosis with evidence, a remediation plan with hours, and a monitoring posture. The ${PRICE_AUDIT} fee is credited forward, so it functions as a deposit on the work rather than a separate cost. Should the findings point nowhere, the report is still yours to use.`,
  },
  {
    q: 'Do I have to buy anything after the review?',
    a: 'No. The review is a standalone engagement with its own deliverable. It is designed to make the next decision obvious, including the decision to stop.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${SITE_URL}/ai-workflow-audit/#service`,
    name: 'AI Workflow Audit',
    alternateName: AUDIT_NAME,
    serviceType: 'AI workflow audit',
    description: AUDIT_HEADLINE_ONE_LINER,
    provider: { '@id': `${SITE_URL}/#organization` },
    areaServed: { '@type': 'Country', name: 'United States' },
    audience: {
      '@type': 'BusinessAudience',
      name: 'Owner-led businesses with 5 to 50 employees',
    },
    url: `${SITE_URL}/ai-workflow-audit/`,
    mainEntityOfPage: `${SITE_URL}/ai-workflow-audit/`,
    offers: {
      '@type': 'Offer',
      priceCurrency: 'USD',
      priceSpecification: {
        '@type': 'PriceSpecification',
        price: PRICE_AUDIT_VALUE,
        priceCurrency: 'USD',
      },
      url: `${SITE_URL}/ai-workflow-audit/`,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    url: `${SITE_URL}/ai-workflow-audit/`,
    mainEntity: faqs.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'AI Workflow Audit',
        item: `${SITE_URL}/ai-workflow-audit/`,
      },
    ],
  },
];
---

<BaseLayout
  title="What Is an AI Workflow Audit? Scope, Cost, and Deliverables | Phronimos"
  description={`An AI workflow audit is a paid diagnosis. The Phronimos version — sold as the ${AUDIT_NAME} — answers "is what you already built actually working?" against the four silent-failure modes. ${PRICE_AUDIT} flat, credited forward.`}
  jsonLd={jsonLd}
>
  <section class="section-tight page-head">
    <div class="container">
      <hr class="rule" data-reveal />
      <p class="eyebrow" data-reveal style="--reveal-i: 1">AI Workflow Audit &middot; {PRICE_AUDIT}, credited forward</p>
      <h1 data-reveal style="--reveal-i: 2">What is an AI workflow audit?</h1>
      <p class="lede answer" data-reveal style="--reveal-i: 3">
        An AI workflow audit is a paid diagnostic engagement that examines the AI agents,
        workflows, and automations a business has already deployed and determines whether they are
        still doing what they were built to do. The Phronimos version — sold as the {AUDIT_NAME} —
        answers one question in writing: <em>is what you already built actually working?</em>
      </p>
      <p class="muted" data-reveal style="--reveal-i: 4">
        {PRICE_AUDIT} flat. Two weeks from kickoff. About 90 minutes of your time. A written report
        you keep whether or not you build anything.
      </p>
      <p class="muted credit-note" data-reveal style="--reveal-i: 5">
        {AUDIT_CREDIT_NOTE}
      </p>
      <div class="cta-actions" data-reveal style="--reveal-i: 6">
        <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Book the {AUDIT_NAME}</a>
        <a href="/tools/reliability-readiness-scorecard/" class="btn btn-secondary">Take the readiness scorecard first</a>
      </div>
    </div>
  </section>

  <section class="section modes-band">
    <div class="container">
      <h2 data-reveal>What does the review check?</h2>
      <p class="lede answer" data-reveal style="--reveal-i: 1">
        Every finding is mapped to one of four silent-failure modes. These are the ways an AI
        workflow fails without setting off any alarm — the failures nobody catches until a customer
        does. If a finding does not map to one of these four modes, it is not in this report; it is
        filed for a different engagement.
      </p>
      <ol class="mode-list" data-reveal style="--reveal-i: 2">
        {
          failureModes.map((mode) => (
            <li>
              <div class="mode-head">
                <span class="mode-id">{mode.id}</span>
                <h3>{mode.name}</h3>
              </div>
              <p class="mode-what">{mode.what}</p>
              <p class="mode-monitor">
                <span class="mode-monitor-label">Caught by</span> {mode.monitor}
              </p>
            </li>
          ))
        }
      </ol>
      <p class="muted modes-note" data-reveal>
        A redacted example of a real incident report — the same shape every retainer client gets —
        is at <a href="/reliability/sample-incident/">sample incident report</a>.
      </p>
    </div>
  </section>

  <section class="section includes-band">
    <div class="container">
      <h2 data-reveal>What does the review include?</h2>
      <p class="lede answer" data-reveal style="--reveal-i: 1">
        A working call, a diagnostic run against the four modes, per-workflow findings with
        evidence, a remediation plan with hours-of-effort per fix, a monitoring posture
        recommendation, and a live review call. Two weeks from kickoff.
      </p>
      <ul class="detail-list" data-reveal style="--reveal-i: 2">
        {
          includes.map(([name, desc]) => (
            <li>
              <h3>{name}</h3>
              <p class="muted">{desc}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section after-band">
    <div class="container">
      <h2 data-reveal>What happens after the review?</h2>
      <p class="lede answer" data-reveal style="--reveal-i: 1">
        Findings sort into four remediation paths. The report says which is which per finding, with
        the hours-of-effort called out so the decision is a business decision, not a technical one.
      </p>
      <ul class="detail-list" data-reveal style="--reveal-i: 2">
        {
          remediationPaths.map(([name, desc]) => (
            <li>
              <h3>{name}</h3>
              <p class="muted">{desc}</p>
            </li>
          ))
        }
      </ul>
      <p class="muted after-note" data-reveal>
        The {PRICE_AUDIT} review fee is credited in full toward an Agent Implementation Sprint or
        the first month of a Fractional AI Officer retainer. If the findings point nowhere, the
        report is still yours to use — the review has already paid for itself by preventing a build
        that would have failed.
      </p>
    </div>
  </section>

  <section class="section compare-band">
    <div class="container">
      <h2 data-reveal>Review, free consultation, or straight to a build?</h2>
      <p class="lede answer" data-reveal style="--reveal-i: 1">
        Three ways to start. The review is the right first step when you have agents running and
        cannot yet answer whether they still work — or when you are about to sink money into
        rebuilding something that only needs monitoring.
      </p>
      <div class="table-wrap" data-reveal style="--reveal-i: 2">
        <table class="compare">
          <thead>
            <tr>
              <th scope="col">Starting point</th>
              <th scope="col">Cost</th>
              <th scope="col">What you get</th>
              <th scope="col">When it is right</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Free consultation</th>
              <td>$0</td>
              <td>A conversation and a list of ideas.</td>
              <td>You already know the workflow and want to test whether a vendor is credible.</td>
            </tr>
            <tr class="highlight">
              <th scope="row">{AUDIT_NAME}</th>
              <td>{PRICE_AUDIT}<span class="credit-flag">credited forward</span></td>
              <td>
                A written diagnosis mapped to the four failure modes, a remediation plan with
                hours, and a monitoring posture.
              </td>
              <td>
                You have AI running and cannot yet say whether it works, or a rebuild is on the
                table and you want to know if it is warranted.
              </td>
            </tr>
            <tr>
              <th scope="row">Straight to a build</th>
              <td>{PRICE_SPRINT}</td>
              <td>One workflow built into a production agent.</td>
              <td>
                Workflow is scoped, inputs identified, escalation path agreed. No diagnosis needed.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="muted compare-note" data-reveal>
        Because the review fee is credited forward, starting with the diagnosis costs nothing extra
        for anyone who goes on to build. It only stays a cost if the findings tell you to stop or
        retire, which is the case where it has already paid for itself.
      </p>
    </div>
  </section>

  <section class="section scorecard-band">
    <div class="container">
      <h2 data-reveal>Not sure if you're ready?</h2>
      <p class="lede answer" data-reveal style="--reveal-i: 1">
        A one-page readiness scorecard runs the same four-mode logic against your current setup in
        about five minutes. Free, no email gate, results on-screen. If the score suggests a review
        is not yet the right step, it tells you what to do instead.
      </p>
      <div class="cta-actions" data-reveal style="--reveal-i: 2">
        <a href="/tools/reliability-readiness-scorecard/" class="btn btn-primary">Take the readiness scorecard</a>
      </div>
    </div>
  </section>

  <section class="section-tight audit-faq">
    <div class="container">
      <h2 data-reveal>AI workflow audit questions</h2>
      <div class="faq-list" data-reveal style="--reveal-i: 1">
        {
          faqs.map(({ q, a }) => (
            <details class="faq-item">
              <summary>{q}</summary>
              <p class="faq-body">{a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container">
      <hr class="rule" data-reveal />
      <h2 class="display" data-reveal style="--reveal-i: 1">Start with the diagnosis.</h2>
      <p class="lede" data-reveal style="--reveal-i: 2">
        Ninety minutes of your time, a fixed fee agreed up front, and a written verdict you keep
        whichever way the decision goes.
      </p>
      <div class="cta-actions" data-reveal style="--reveal-i: 3">
        <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Book the {AUDIT_NAME}</a>
        <span class="muted">or write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></span>
      </div>
      <p class="footer-note">Last reviewed: 2026-08-13.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head h1 {
    margin-top: var(--space-4);
    max-width: 20ch;
  }

  .page-head .answer {
    margin-top: var(--space-5);
  }

  .page-head .muted {
    margin-top: var(--space-5);
    max-width: 60ch;
    font-size: 15.5px;
  }

  .answer {
    max-width: 66ch;
  }

  section > .container > .answer,
  section > .container > .lede.answer {
    margin-top: var(--space-4);
  }

  .modes-band {
    border-top: 1px solid var(--line);
    background: var(--surface-raised);
  }

  .mode-list {
    list-style: none;
    padding: 0;
    margin: var(--space-7) 0 0;
    counter-reset: mode;
    border-top: 1px solid var(--line);
  }

  .mode-list li {
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--line);
  }

  .mode-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .mode-id {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--accent-strong);
    font-weight: 500;
  }

  .mode-list h3 {
    font-size: 18px;
    margin: 0;
    max-width: 60ch;
  }

  .mode-what {
    margin-top: var(--space-3);
    max-width: 68ch;
    color: var(--text-secondary);
    font-size: 15.5px;
  }

  .mode-monitor {
    margin-top: var(--space-3);
    max-width: 68ch;
    font-size: 14.5px;
  }

  .mode-monitor-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-strong);
    margin-right: var(--space-2);
  }

  .modes-note {
    margin-top: var(--space-6);
    max-width: 64ch;
    font-size: 15px;
  }

  .includes-band {
    border-top: 1px solid var(--line);
  }

  .after-band {
    border-top: 1px solid var(--line);
    background: var(--surface-raised);
  }

  .detail-list {
    list-style: none;
    padding: 0;
    margin: var(--space-7) 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6) var(--space-7);
    border-top: 1px solid var(--line);
    padding-top: var(--space-6);
  }

  .detail-list h3 {
    font-size: 17px;
  }

  .detail-list .muted {
    margin-top: var(--space-2);
    font-size: 15px;
    max-width: 48ch;
  }

  .after-note {
    margin-top: var(--space-6);
    max-width: 66ch;
    font-size: 15px;
  }

  .compare-band {
    border-top: 1px solid var(--line);
    background: var(--surface-band);
  }

  .table-wrap {
    margin-top: var(--space-7);
    overflow-x: auto;
  }

  table.compare {
    width: 100%;
    border-collapse: collapse;
    min-width: 680px;
    font-size: 15.5px;
  }

  table.compare th,
  table.compare td {
    text-align: left;
    vertical-align: top;
    padding: var(--space-4) var(--space-5) var(--space-4) 0;
    border-bottom: 1px solid var(--line);
  }

  table.compare thead th {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    border-bottom: 1px solid var(--line-strong);
  }

  table.compare tbody th {
    font-family: var(--font-tight);
    font-weight: 500;
    font-size: 16.5px;
    letter-spacing: -0.01em;
    padding-right: var(--space-6);
  }

  table.compare td {
    color: var(--text-secondary);
    max-width: 36ch;
  }

  table.compare tr.highlight th,
  table.compare tr.highlight td {
    background: var(--surface-callout);
  }

  table.compare tr.highlight th {
    color: var(--accent-strong);
  }

  .compare-note {
    margin-top: var(--space-5);
    max-width: 66ch;
    font-size: 15px;
  }

  .credit-flag {
    display: block;
    margin-top: 3px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }

  .credit-note {
    margin-top: var(--space-4);
    max-width: 60ch;
    font-size: 15.5px;
    padding-left: var(--space-4);
    border-left: 2px solid var(--accent-solid);
  }

  .scorecard-band {
    border-top: 1px solid var(--line);
  }

  .audit-faq .faq-list {
    margin-top: var(--space-6);
    max-width: 76ch;
  }

  .final-cta .display {
    max-width: 16ch;
  }

  .final-cta .lede {
    margin-top: var(--space-5);
    max-width: 52ch;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-7);
  }

  .footer-note {
    margin-top: var(--space-7);
    font-size: 13px;
    color: var(--text-tertiary);
  }

  @media (max-width: 860px) {
    .detail-list {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
