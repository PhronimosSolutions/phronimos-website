---
import BaseLayout from '../layouts/BaseLayout.astro';
import FigOperator from '../components/figures/FigOperator.astro';
import FigBottleneck from '../components/figures/FigBottleneck.astro';
import {
  AUDIT_CREDIT_NOTE,
  BOOKING_URL,
  CONTACT_EMAIL,
  PRICE_AUDIT,
  PRICE_AUDIT_VALUE,
  PRICE_RETAINER,
  PRICE_RETAINER_VALUE,
  PRICE_SPRINT,
  PRICE_SPRINT_VALUE,
  PUBLISH_SERVICE_STANDARD,
  SERVICE_STANDARD,
  SITE_URL,
} from '../config';

// The organization entity now lives site-wide in BaseLayout with a stable @id.
// This page adds only the offer catalogue, referenced back to that entity.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Phronimos engagements',
  url: SITE_URL,
  provider: { '@id': `${SITE_URL}/#organization` },
  itemListElement: [
    {
      '@type': 'Offer',
      name: 'AI Workflow Audit',
      description:
        'A paid diagnosis of where operational time is leaking, with a findings report and a scoped first build.',
      priceCurrency: 'USD',
      priceSpecification: {
        '@type': 'PriceSpecification',
        price: PRICE_AUDIT_VALUE,
        priceCurrency: 'USD',
      },
      url: `${SITE_URL}/ai-workflow-audit/`,
    },
    {
      '@type': 'Offer',
      name: 'Agent Implementation Sprint',
      description:
        'One workflow built into a production AI agent, tested against live examples and handed over with guardrails and an SOP.',
      priceCurrency: 'USD',
      priceSpecification: {
        '@type': 'PriceSpecification',
        minPrice: PRICE_SPRINT_VALUE,
        priceCurrency: 'USD',
      },
      url: `${SITE_URL}/services/`,
    },
    {
      '@type': 'Offer',
      name: 'Managed AI Operator Retainer',
      description:
        'Monitoring, maintenance, and continued rollout of the AI agent layer under a monthly retainer.',
      priceCurrency: 'USD',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: PRICE_RETAINER_VALUE,
        priceCurrency: 'USD',
        unitCode: 'MON',
      },
      url: `${SITE_URL}/services/`,
    },
  ],
};

// Where most first builds land: universal, high-volume, easy to measure.
const starters = [
  ['Inbox triage', 'Priority surfaced, noise filed, drafts staged for review.'],
  ['Meeting follow-up', 'Summaries, next steps, and owners captured every time.'],
  ['Lead intake and routing', 'Every inquiry qualified and put in front of the right person.'],
  ['Document chase-ups', 'The polite persistence nobody on your team has time for.'],
  ['Repeated internal questions', 'Answers pulled from your own knowledge, on demand.'],
  ['Open-loop tracking', 'Commitments tracked until they close.'],
];

// Where a custom build earns the retainer: multi-system, judgment-bearing,
// consequential if it goes wrong. These describe the shape of the work, not
// past engagements.
const custom = [
  [
    'Matter intake and conflict screening',
    'Inbound inquiry parsed, conflicts checked against the practice-management system, engagement letter drafted, and non-viable matters declined with the reason on file.',
  ],
  [
    'Renewal chase across a book of business',
    'Policy data reconciled from the agency management system, exposure changes flagged, and client outreach sequenced and escalated by expiry date.',
  ],
  [
    'Candidate screening against a live requisition',
    'Applicants scored against the actual scorecard, notes written back to the ATS, and borderline cases escalated with the reasoning attached.',
  ],
];

const fits = [
  'You lead a team of 5 to 50 and operations still route through you.',
  'Repeated admin and follow-up work eats hours every week.',
  'The SaaS stack is full, yet the work is still manual.',
  'You want someone accountable for the system after it goes live.',
];
---

<BaseLayout
  title="Managed AI Agents for Businesses | Phronimos"
  description="Phronimos designs, builds, and runs custom AI agents for owner-led businesses. Start with a $999 AI Workflow Audit, credited toward the build that follows."
  jsonLd={jsonLd}
>
  <!-- 1. Hero: asymmetric split -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" data-reveal>Managed AI agents</p>
        <h1 class="display" data-reveal style="--reveal-i: 1">
          The work that only moves<br class="hero-br" /> when you push it. <em>Handled.</em>
        </h1>
        <p class="lede" data-reveal style="--reveal-i: 2">
          Phronimos designs, builds, and runs custom AI agents for owner-led businesses. Each one is
          wired into your systems, tested against your own cases, and monitored by us. You approve
          outcomes. We own the machinery.
        </p>
        <div class="hero-ctas" data-reveal style="--reveal-i: 3">
          <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Book the AI Workflow Audit</a>
          <a href="/method/" class="btn btn-secondary">See how it works</a>
        </div>
      </div>

      <aside class="hero-panel card" data-reveal style="--reveal-i: 2" aria-label="What clients buy">
        <p class="panel-label">What clients buy</p>
        <p class="panel-statement">
          Fewer dropped follow-ups. Cleaner handoffs. Capacity without another hire.
        </p>
        <ul class="panel-list">
          <li>
            <span>AI Workflow Audit</span>
            <span class="muted">{PRICE_AUDIT}</span>
          </li>
          <li>
            <span>Agent Implementation Sprint</span>
            <span class="muted">{PRICE_SPRINT}</span>
          </li>
          <li>
            <span>Managed AI Operator Retainer</span>
            <span class="muted">{PRICE_RETAINER}</span>
          </li>
        </ul>
      </aside>
    </div>
    <div class="hero-geometry" aria-hidden="true"></div>
  </section>

  <!-- 2. Definition: entity clarity, above the fold-adjacent -->
  <section class="section-tight definition">
    <div class="container definition-grid">
      <div class="definition-inner">
        <p class="eyebrow" data-reveal>Definition</p>
        <h2 class="h1" data-reveal style="--reveal-i: 1">What is a managed AI operator?</h2>
        <p class="lede answer" data-reveal style="--reveal-i: 2">
          A Phronimos operator is a custom AI agent built for one job inside your business:
          connected to your systems, bounded by explicit guardrails, and monitored by us. Not a
          subscription you configure and forget. A working system somebody is accountable for.
        </p>
        <p class="muted" data-reveal style="--reveal-i: 3">
          Most of the market calls these AI agents. We call ours operators because the agent is only
          half of what you buy. The other half is the monitoring, versioning, and escalation that
          keeps it working in month six, when the tool it depends on changes and nobody on your team
          notices.
        </p>
      </div>
      <div class="definition-fig">
        <FigOperator />
      </div>
    </div>
  </section>

  <!-- 3. Problem: editorial manifesto band -->
  <section class="section problem">
    <div class="container problem-inner">
      <hr class="rule" data-reveal />
      <h2 class="h1" data-reveal style="--reveal-i: 1">
        Your stack is full. The work is still manual.
      </h2>
      <p class="lede" data-reveal style="--reveal-i: 2">
        A CRM, a project tracker, a shared inbox, a meeting recorder, two automation platforms, and
        an AI subscription someone bought after a conference. And the owner still clears email on
        Sunday night.
      </p>
      <p class="muted trust-line" data-reveal style="--reveal-i: 3">
        Software waits to be operated. The workflows that hurt are the ones nobody has time to
        operate. Phronimos gives those workflows an owner that does not get busy.
      </p>
      <div class="problem-fig">
        <FigBottleneck />
      </div>
    </div>
  </section>

  <!-- 4. Method: staggered progression -->
  <section class="section method">
    <div class="container">
      <h2 data-reveal>How a Phronimos engagement works</h2>
      <p class="lede method-lede" data-reveal style="--reveal-i: 1">
        Audit first. Build second. Manage ongoing.
      </p>
      <div class="method-steps">
        <article class="card method-card" data-reveal>
          <p class="step-name">Audit</p>
          <h3>Find the operational leak.</h3>
          <p class="muted">
            A paid diagnosis. We review your workflows and tool stack, find where time leaks, and
            report what should move first.
          </p>
        </article>
        <article class="card method-card offset-1" data-reveal style="--reveal-i: 1">
          <p class="step-name">Sprint</p>
          <h3>Build the first operator.</h3>
          <p class="muted">
            One painful workflow built, tested with live examples, and handed off with guardrails
            and a clear SOP.
          </p>
        </article>
        <article class="card method-card offset-2" data-reveal style="--reveal-i: 2">
          <p class="step-name">Manage</p>
          <h3>Keep the system running.</h3>
          <p class="muted">
            Monitoring, maintenance, escalation, and new rollouts under one retainer. The layer
            keeps earning its keep.
          </p>
        </article>
      </div>
      <p class="method-link" data-reveal><a href="/method/">Read the full method</a></p>
    </div>
  </section>

  <!-- 5. Signal room: the deliberate warm band -->
  <section class="section signal-room">
    <div class="container">
      <p class="eyebrow" data-reveal>The managed layer</p>
      <h2 data-reveal style="--reveal-i: 1">What does a managed AI agent service include?</h2>
      <p class="lede answer" data-reveal style="--reveal-i: 2">
        Every operator Phronimos builds is monitored, versioned, and covered by a service standard.
        When something breaks, we find out first, contain it, and tell you what happened with the
        trace attached.
      </p>
      <div class="signal-grid">
        <article class="signal-card signal-live" data-reveal>
          <div class="signal-mark" aria-hidden="true">
            <svg viewBox="0 0 119.13 137.6" width="60" height="69" fill="#eef2f4" role="img">
              <path
                d="M62.76,136.6c-2.51,1.47-5.59,1.31-7.86-.46L2.05,105.09c-.79-.84-2.04-2.97-2.04-4.11v-63.7c-.01-1.97,1.55-4.16,3.24-5.17L54.37,1.68c3.59-2.14,7.03-2.41,10.57.24l50.3,29.7c1.98,1.17,3.89,3.14,3.89,5.65l-.02,63.05c0,2.89-2.24,4.51-4.47,5.82l-51.88,30.47ZM53.57,68.47l.47,57.82c1.39,1.58,3.46,2.73,5.67,3.1l51.82-30.5-.07-60.72L59.31,7.55,7.42,38.56l.05,60.77,21.36,12.6v-57.8l24.74,14.34Z"
              ></path>
              <polygon points="59.31 65.45 32.78 49.77 59.44 33.63 86.86 49.23 59.31 65.45"></polygon>
              <polygon
                points="59.82 110.5 59.56 93.18 69.53 87.31 69.54 65.65 89.54 54.04 89.7 92.94 59.82 110.5"
              ></polygon>
            </svg>
          </div>
          <p class="signal-status"><span class="signal-dot"></span>Monitoring · live</p>
          <h3>You hear it from us first.</h3>
          <p class="muted">
            Failure alerts route to us, never to your team. Recovery paths run automatically where
            they can, and escalation goes to a named person rather than a ticket queue.
          </p>
        </article>

        {
          PUBLISH_SERVICE_STANDARD ? (
            SERVICE_STANDARD.slice(0, 3).map((item, i) => (
              <article class="signal-card" data-reveal style={`--reveal-i: ${i + 1}`}>
                <p class="metric">{item.metric}</p>
                <p class="signal-label">{item.label}</p>
                <p class="muted">{item.detail}</p>
              </article>
            ))
          ) : (
            <>
              <article class="signal-card" data-reveal style="--reveal-i: 1">
                <p class="metric">Under 48h</p>
                <p class="signal-label">New request turnaround</p>
                <p class="muted">
                  Target on retainer work. Incidents are handled on their own clock, not this one.
                </p>
              </article>

              <article class="signal-card" data-reveal style="--reveal-i: 2">
                <h3>Versioned, and reversible.</h3>
                <p class="muted">
                  Prompts, models, and guardrails are versioned. Every change is testable, and every
                  action an operator takes leaves a trace you can read.
                </p>
              </article>
            </>
          )
        }

        <article class="signal-card signal-wide" data-reveal style="--reveal-i: 3">
          <h3>One controlled path.</h3>
          <p class="muted">
            The audit finds the leak. The sprint proves the fix. The retainer keeps the operator
            layer running, and growing, without your attention.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- 6. Operators: split list with aside -->
  <section class="section operators">
    <div class="container operators-grid">
      <div class="operators-intro">
        <h2 data-reveal>Which workflows should become AI agents first?</h2>
        <p class="lede answer" data-reveal style="--reveal-i: 1">
          The first build is almost always a workflow every owner-led team drowns in: high volume,
          low judgment, easy to measure. The retainer is where operators get specific to your
          business.
        </p>
        <div class="callout" data-reveal style="--reveal-i: 2">
          <p class="callout-head">The machinery stays with us.</p>
          <p>
            You never choose a model, manage a token budget, or debug an integration. Phronimos owns
            the runtime, the auth layer, the monitoring, and the version history for everything it
            builds.
          </p>
        </div>
      </div>
      <div class="operators-lists">
        <h3 class="list-label">Where most teams start</h3>
        <ul class="operators-list">
          {
            starters.map(([name, desc], i) => (
              <li data-reveal style={`--reveal-i: ${i % 2}`}>
                <h4>{name}</h4>
                <p class="muted">{desc}</p>
              </li>
            ))
          }
        </ul>

        <h3 class="list-label list-label-second">Where a custom operator earns its keep</h3>
        <ul class="operators-list operators-list-single">
          {
            custom.map(([name, desc], i) => (
              <li data-reveal style={`--reveal-i: ${i % 2}`}>
                <h4>{name}</h4>
                <p class="muted">{desc}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 7. Who it's for: typographic grid -->
  <section class="section-tight who">
    <div class="container">
      <h2 data-reveal>Who is a managed AI operator for?</h2>
      <ul class="who-grid">
        {
          fits.map((fit, i) => (
            <li data-reveal style={`--reveal-i: ${i}`}>
              <p>{fit}</p>
            </li>
          ))
        }
      </ul>
      <p class="muted markets" data-reveal>
        Common fits: agencies, law firms, insurance teams, real estate teams, recruiting firms, and
        service businesses with an office to run.
      </p>
    </div>
  </section>

  <!-- 8. Engagement model: divided rows -->
  <section class="section engagement">
    <div class="container">
      <h2 data-reveal>What does it cost?</h2>
      <p class="lede answer" data-reveal style="--reveal-i: 1">
        An AI Workflow Audit costs {PRICE_AUDIT}. An Agent Implementation Sprint starts at $3,500,
        depending on integration complexity. The Managed AI Operator Retainer is $5,000 per month.
        Scope changes are re-priced in writing before work continues.
      </p>
      <p class="muted credit-note" data-reveal style="--reveal-i: 2">
        {AUDIT_CREDIT_NOTE}
      </p>
      <div class="offer-rows">
        <a class="offer-row" href="/ai-workflow-audit/" data-reveal>
          <span class="offer-price">{PRICE_AUDIT}</span>
          <span>
            <span class="offer-name">AI Workflow Audit</span>
            <span class="muted offer-desc"
              >Recorded discovery, workflow and tool-stack review, findings report, and a scoped
              first sprint.</span
            >
          </span>
          <span class="offer-arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a class="offer-row" href="/services/" data-reveal style="--reveal-i: 1">
          <span class="offer-price">{PRICE_SPRINT}</span>
          <span>
            <span class="offer-name">Agent Implementation Sprint</span>
            <span class="muted offer-desc"
              >One workflow built into a production agent, tested on live examples, handed over with
              guardrails and an SOP.</span
            >
          </span>
          <span class="offer-arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a class="offer-row" href="/services/" data-reveal style="--reveal-i: 2">
          <span class="offer-price">{PRICE_RETAINER}</span>
          <span>
            <span class="offer-name">Managed AI Operator Retainer</span>
            <span class="muted offer-desc"
              >Monitoring, maintenance, new rollout, and a queue you can see into.</span
            >
          </span>
          <span class="offer-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 9. FAQ teaser -->
  <section class="section-tight faq-teaser">
    <div class="container faq-grid">
      <h2 data-reveal>Questions owners ask</h2>
      <div>
        <details class="faq-item" data-reveal>
          <summary>Is the audit the whole engagement?</summary>
          <p class="faq-body">
            The AI Workflow Audit is a paid diagnosis that scopes the first build. A full engagement
            runs audit, then implementation sprint, then managed retainer.
          </p>
        </details>
        <details class="faq-item" data-reveal style="--reveal-i: 1">
          <summary>Do I need to understand AI models or tooling?</summary>
          <p class="faq-body">
            No. Clients approve outcomes and watch a shared request queue. Model selection,
            infrastructure, authentication, monitoring, and version control sit with Phronimos.
          </p>
        </details>
        <details class="faq-item" data-reveal style="--reveal-i: 2">
          <summary>How much does it cost to have AI agents built and maintained?</summary>
          <p class="faq-body">
            Phronimos charges {PRICE_AUDIT} for a workflow audit, from $3,500 to build and deploy
            the first agent, and $5,000 per month to monitor, maintain, and expand the agent layer.
            The audit fee is credited toward whichever comes next.
          </p>
        </details>
        <p class="faq-more" data-reveal><a href="/faq/">Read the full FAQ</a></p>
      </div>
    </div>
  </section>

  <!-- 10. Final CTA: editorial -->
  <section class="section final-cta">
    <div class="container">
      <hr class="rule" data-reveal />
      <h2 class="display" data-reveal style="--reveal-i: 1">Start with the audit.</h2>
      <p class="lede" data-reveal style="--reveal-i: 2">
        If work keeps piling up around you, the first move is finding which of it should become an
        operator, and getting that one live.
      </p>
      <p class="muted cta-links" data-reveal style="--reveal-i: 3">
        Before you book: <a href="/ai-workflow-audit/">what the audit includes</a> &middot;
        <a href="/security/">how we handle access to your systems</a>
      </p>
      <div class="cta-actions" data-reveal style="--reveal-i: 3">
        <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Book the AI Workflow Audit</a>
        <span class="muted">or write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(64px, 9vw, 112px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hero-copy .display {
    margin-top: var(--space-5);
  }

  @media (max-width: 860px) {
    .hero-br {
      display: none;
    }
  }

  .hero-copy .lede {
    margin-top: var(--space-5);
    max-width: 46ch;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-7);
  }

  .hero-geometry {
    position: absolute;
    right: -200px;
    top: -160px;
    width: 620px;
    height: 620px;
    border: 1px solid var(--accent-line);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-geometry::before {
    content: '';
    position: absolute;
    inset: 78px;
    border: 1px dashed var(--grid-line);
    border-radius: 50%;
  }

  .hero-panel {
    padding: var(--space-6);
    border-left: 4px solid var(--accent-solid);
    border-radius: 6px var(--radius-card) var(--radius-card) 6px;
  }

  .panel-label {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .panel-statement {
    font-family: var(--font-display);
    font-weight: 460;
    font-size: clamp(21px, 2vw, 26px);
    line-height: 1.28;
    letter-spacing: -0.01em;
    margin-top: var(--space-4);
  }

  .panel-list {
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 0;
  }

  .panel-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-top: 1px solid var(--line);
    font-family: var(--font-tight);
    font-weight: 500;
    font-size: 16px;
  }

  .panel-list .muted {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 14px;
    text-align: right;
  }

  /* Definition band: the passage carries the words, FIG. 01 carries the
     shape. Text left, plate right, on the same baseline. */
  .definition {
    border-top: 1px solid var(--line);
    background: var(--surface-raised);
  }

  .definition-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(40px, 5vw, 72px);
    align-items: center;
  }

  .definition-inner {
    max-width: 640px;
  }

  /* The plate sits at the head of its column rather than centred in it:
     centring would shrink the grid item to fit-content and take the
     drawing down with it. */
  .definition-fig {
    margin-top: var(--space-2);
  }

  .definition .h1 {
    margin-top: var(--space-4);
    max-width: 22ch;
  }

  .definition .answer {
    margin-top: var(--space-5);
    max-width: 62ch;
  }

  .definition .muted {
    margin-top: var(--space-5);
    max-width: 66ch;
    font-size: 15.5px;
  }

  /* A self-contained answer paragraph: sits directly under a question heading,
     carries no links, and reads correctly if lifted out of the page alone. */
  .answer {
    max-width: 62ch;
  }

  /* Problem band: offset editorial */
  .problem-inner {
    max-width: 880px;
    padding-left: clamp(0px, 6vw, 96px);
  }

  .problem .rule {
    margin-bottom: var(--space-6);
  }

  .problem .h1 {
    max-width: 20ch;
  }

  .problem .lede {
    margin-top: var(--space-5);
    max-width: 56ch;
  }

  .trust-line {
    margin-top: var(--space-5);
    font-size: 15.5px;
    max-width: 56ch;
  }

  .problem-fig {
    margin-top: var(--space-8);
  }

  /* Method: staggered cards over a connecting hairline */
  .method-lede {
    margin-top: var(--space-4);
    max-width: 44ch;
  }

  .method-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-8);
    position: relative;
  }

  .method-steps::before {
    content: '';
    position: absolute;
    left: 0;
