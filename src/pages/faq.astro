---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUDIT_NAME, BOOKING_URL, SITE_URL } from '../config';

// Answers are written to survive being read alone: no pronouns pointing at other
// entries, no "as mentioned above", and the subject restated in the first clause.
// Retrieval systems chunk by question, and a chunk has to make sense by itself.
const faqs = [
  {
    q: 'How much does it cost to have AI agents built and maintained for a small business?',
    a: 'Phronimos charges $999 for an Agent Reliability Review — a diagnostic that answers "is what you already built actually working?" — from $3,500 for an Agent Implementation Sprint that puts the first agent into production, and $5,000 per month for the Fractional AI Officer retainer (roughly one junior FTE, without the hire). The review fee is credited in full toward a sprint or the first month of a retainer. A first year covering the review, one sprint, and twelve months of retainer starts around $63,500. Scope changes are re-priced in writing before work continues.',
  },
  {
    q: 'What is a managed AI operator?',
    a: 'A managed AI operator is a custom AI agent built for one specific job inside a business, connected to that business systems, bounded by explicit guardrails, and monitored by the firm that built it. The distinction from an AI tool is ownership: an operator has someone accountable for it continuing to work.',
  },
  {
    q: 'How is Phronimos different from AI consulting?',
    a: 'AI consulting typically ends at a recommendation. Phronimos runs the diagnosis, builds the agent, puts it into production, and stays accountable for it working afterward. The deliverable is a running system with a service standard behind it.',
  },
  {
    q: 'Should we hire someone to build AI automations, or build them in-house?',
    a: 'Building in-house makes sense when a business has an engineer who can own the system for the next two years. Most companies with 5 to 50 people do not, and the failure point is rarely the build. It is month four, when an upstream tool changes and nobody notices the automation stopped working.',
  },
  {
    q: `Is the ${AUDIT_NAME} the whole engagement?`,
    a: `The ${AUDIT_NAME} is the paid diagnosis and the scoping document for what follows. A full Phronimos engagement runs review, then implementation sprint, then managed retainer. The review exists so the first build aims at the right workflow.`,
  },
  {
    q: 'Do I need to understand AI models or tooling to work with Phronimos?',
    a: 'No. Clients approve outcomes and watch a shared request queue. Model selection, infrastructure, authentication, monitoring, and version control sit with Phronimos.',
  },
  {
    q: 'Which workflows should become AI agents first?',
    a: 'The best first candidates are high-volume, low-judgment, and easy to measure: inbox triage, meeting follow-up, lead intake and routing, document chase-ups, and repeated internal questions. Workflows specific to an industry come second, once the pattern is proven in that business.',
  },
  {
    q: 'Why does Phronimos charge for the audit instead of offering a free call?',
    a: 'A paid diagnosis keeps the engagement bounded and serious on both sides. Reviewing how work moves through a company, sizing what it costs, and scoping a build against it takes days of work, and pricing it that way means the findings get the attention they need. A free call tends to produce a list nobody owns.',
  },
  {
    q: 'What happens when an AI agent breaks?',
    a: 'Every Phronimos operator carries monitoring and failure alerts that route to Phronimos rather than to the client team. Automatic recovery runs where it is possible, escalation goes to a named person, and every incident ends in a written account of what happened and what changed.',
  },
  {
    q: 'Who owns what Phronimos builds?',
    a: 'The workflows, SOPs, and configurations built for a client business are documented and handed over, so the client is not locked in. Ownership terms are set out plainly in each statement of work before the work starts.',
  },
  {
    q: 'Who can access our data, and where does it live?',
    a: 'Phronimos never holds client passwords. System access runs through a managed authentication layer where the client admin completes every authorization directly with the source system, and access is scoped to the systems named in the statement of work. Each client gets an isolated authentication surface, and access is revoked when the engagement ends.',
  },
  {
    q: 'Does Phronimos specialize by industry?',
    a: 'Not yet, by design. Phronimos currently works across several operator-heavy markets, including agencies, law firms, insurance teams, real estate teams, and recruiting firms, and will narrow where the pull is strongest. The universal workflows are close enough across these industries that the early lessons transfer.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
  url: `${SITE_URL}/faq/`,
};
---

<BaseLayout
  title="AI Agent Services FAQ: Cost, Scope, Ownership, Security | Phronimos"
  description="Straight answers on what Phronimos costs, what a managed AI operator is, who owns what gets built, and what happens when an AI agent breaks."
  jsonLd={jsonLd}
>
  <section class="section faq-page">
    <div class="container faq-layout">
      <div class="faq-head">
        <hr class="rule" data-reveal />
        <h1 data-reveal style="--reveal-i: 1">Questions owners ask</h1>
        <p class="lede" data-reveal style="--reveal-i: 2">
          Cost, scope, ownership, and what happens when something breaks. Anything missing,
          <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer">ask us directly</a>.
        </p>
      </div>
      <div class="faq-list">
        {
          faqs.map(({ q, a }, i) => (
            <details class="faq-item" data-reveal style={`--reveal-i: ${Math.min(i, 4)}`}>
              <summary>{q}</summary>
              <p class="faq-body">{a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .faq-layout {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .faq-head h1 {
    margin-top: var(--space-6);
    max-width: 14ch;
  }

  .faq-head .lede {
    margin-top: var(--space-4);
    max-width: 34ch;
  }

  @media (max-width: 860px) {
    .faq-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
