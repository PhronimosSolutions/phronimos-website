---
import BaseLayout from '../layouts/BaseLayout.astro';
import FigStages from '../components/figures/FigStages.astro';
import FigDetection from '../components/figures/FigDetection.astro';
import {
  BOOKING_URL,
  CONTACT_EMAIL,
  PUBLISH_SERVICE_STANDARD,
  SERVICE_STANDARD,
  SITE_URL,
} from '../config';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Managed AI agent implementation',
  serviceType: 'AI agent design, implementation, and managed operation',
  provider: { '@id': `${SITE_URL}/#organization` },
  areaServed: { '@type': 'Country', name: 'United States' },
  audience: {
    '@type': 'BusinessAudience',
    name: 'Owner-led businesses with 5 to 50 employees',
  },
  url: `${SITE_URL}/method/`,
};

const steps = [
  {
    name: 'AI Workflow Audit',
    head: 'Find the operational leak.',
    intro:
      'A focused, paid diagnosis of where work is leaking and which workflows should be handled first. Bounded, useful, and concrete.',
    includes: [
      '45-minute recorded discovery call',
      'Workflow and tool-stack review',
      'Bottleneck analysis',
      'Custom findings report with 3 to 5 recommendations',
      'ROI baseline estimate',
      '30-minute review call',
      'Recommended first-sprint scope',
    ],
    outcome:
      'A clear diagnosis of where time is leaking and which one or two workflows should move first. You will know what should stay human, what should become a workflow, and what should become a managed AI operator.',
  },
  {
    name: 'Agent Implementation Sprint',
    head: 'Build the first operator.',
    intro:
      'One workflow gets designed, built, tested against live examples, and handed over with guardrails and documentation.',
    includes: [
      'First-operator design',
      'Agent and runtime configuration',
      'Authentication and integration setup',
      'Testing with live examples',
      'Guardrails and escalation paths',
      'SOP and handoff notes',
      'Team training session',
    ],
    outcome:
      'One workflow becomes measurably faster and less owner-dependent. The deliverable is a running system with a documented maintenance path, and a baseline to measure it against.',
  },
  {
    name: 'Managed AI Operator Retainer',
    head: 'Keep the system running.',
    intro:
      'The retainer makes AI adoption a line in your operating budget with an owner attached. This is the ongoing partnership.',
    includes: [
      'One to two active requests at a time',
      'Under-48-hour turnaround target',
      'Monitoring and failure alerts',
      'Maintenance and tuning',
      'New workflow rollout',
      'A customer-facing request queue',
      'Async video updates on work delivered',
      'Continuous optimization',
    ],
    outcome:
      'An operator layer that keeps expanding without your attention, run by a partner who is accountable for it working.',
  },
];
---

<BaseLayout
  title="How AI Agent Implementation Works: Audit, Sprint, Retainer | Phronimos"
  description="How Phronimos builds and runs AI agents: a paid audit finds the operational leak, a sprint puts the first agent into production, and a retainer keeps it running."
  jsonLd={jsonLd}
>
  <section class="section-tight page-head">
    <div class="container">
      <hr class="rule" data-reveal />
      <h1 data-reveal style="--reveal-i: 1">How Phronimos builds and runs your AI agents</h1>
      <p class="lede" data-reveal style="--reveal-i: 2">
        <strong>Audit first. Build second. Manage ongoing.</strong> A paid diagnosis finds where work
        leaks and scopes the build. A sprint puts the first operator into production. A monthly
        retainer keeps it running and adds the next one. Each step ends in something you can hold,
        and each one is a decision point.
      </p>
      <p class="muted head-links" data-reveal style="--reveal-i: 3">
        Start here: <a href="/ai-workflow-audit/">what an AI workflow audit includes</a>, or read
        <a href="/security/">how we handle access to your systems</a>.
      </p>
      <div class="head-fig">
        <FigStages />
      </div>
    </div>
  </section>

  {
    steps.map((step, i) => (
      <section class={`section step-section ${i % 2 ? 'step-alt' : ''}`}>
        <div class="container step-grid">
          <div class="step-lead" data-reveal>
            <p class="step-name">{step.name}</p>
            <h2>{step.head}</h2>
            <p class="lede">{step.intro}</p>
          </div>
          <div class="step-detail" data-reveal style="--reveal-i: 1">
            <h3 class="list-head">What happens</h3>
            <ul class="include-list">
              {step.includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <div class="callout outcome">
              <p class="outcome-head">The outcome</p>
              <p>{step.outcome}</p>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class="section-tight reliability">
    <div class="container">
      <h2 data-reveal>What happens when an AI agent breaks?</h2>
      <p class="lede answer" data-reveal style="--reveal-i: 1">
        Every operator carries monitoring, failure alerts, automatic recovery where it is possible,
        and a named escalation path. Alerts reach Phronimos before they reach you, and every
        incident ends in a written account of what happened and what changed.
      </p>
      <p class="muted reliability-note" data-reveal style="--reveal-i: 2">
        An agent that works most of the time is a liability, because the failures are silent and the
        cost lands on whoever was trusting it. So reliability is engineered first and measured
        continuously, on our side of the line.
      </p>

      <div class="reliability-fig">
        <FigDetection />
      </div>

      {
        PUBLISH_SERVICE_STANDARD && (
          <div class="standard-grid" data-reveal style="--reveal-i: 3">
            {SERVICE_STANDARD.map((item) => (
              <div class="standard-item">
                <p class="metric">{item.metric}</p>
                <p class="standard-label">{item.label}</p>
                <p class="muted">{item.detail}</p>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section class="section final-cta">
    <div class="container">
      <h2 class="display" data-reveal>Start where the risk is lowest.</h2>
      <p class="lede" data-reveal style="--reveal-i: 1">
        The audit is a bounded first step with a concrete deliverable, and it is the only
        commitment you make up front. Everything after it is a separate decision.
      </p>
      <div class="cta-actions" data-reveal style="--reveal-i: 2">
        <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Book the AI Workflow Audit</a>
        <span class="muted">or write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head h1 {
    margin-top: var(--space-6);
    max-width: 22ch;
  }

  .page-head .lede {
    margin-top: var(--space-5);
    max-width: 62ch;
  }

  .head-links {
    margin-top: var(--space-5);
    font-size: 15.5px;
  }

  .head-fig,
  .reliability-fig {
    margin-top: var(--space-8);
  }

  .answer {
    max-width: 64ch;
  }

  .step-section {
    border-top: 1px solid var(--line);
  }

  .step-alt {
    background: var(--surface-raised);
  }

  .step-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .step-name {
    font-family: var(--font-tight);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }

  .step-lead h2 {
    margin-top: var(--space-3);
  }

  .step-lead .lede {
    margin-top: var(--space-4);
  }

  .list-head {
    font-size: 16px;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .include-list {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
    columns: 2;
    column-gap: var(--space-6);
  }

  .include-list li {
    break-inside: avoid;
    padding-block: var(--space-2);
    font-size: 16px;
  }

  .outcome {
    margin-top: var(--space-6);
  }

  .outcome-head {
    font-family: var(--font-tight);
    font-weight: 500;
    color: var(--accent-strong);
    font-size: 15px;
  }

  .outcome p + p {
    margin-top: var(--space-2);
    font-size: 15.5px;
  }

  .reliability .lede {
    margin-top: var(--space-4);
    max-width: 62ch;
  }

  .reliability-note {
    margin-top: var(--space-5);
    max-width: 62ch;
    font-size: 15.5px;
  }

  /* Published service standard. Numbers, not nouns: this is the block that
     separates a managed service from a list of activities. */
  .standard-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }

  .standard-label {
    font-family: var(--font-tight);
    font-weight: 500;
    font-size: 15px;
    margin-top: var(--space-2);
  }

  .standard-item .muted {
    margin-top: var(--space-2);
    font-size: 14.5px;
  }

  @media (max-width: 960px) {
    .standard-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .final-cta .display {
    max-width: 16ch;
  }

  .final-cta .lede {
    margin-top: var(--space-5);
    max-width: 52ch;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-7);
  }

  @media (max-width: 860px) {
    .step-grid {
      grid-template-columns: 1fr;
    }

    .include-list {
      columns: 1;
    }

    .standard-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
