---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  AUDIT_HEADLINE_ONE_LINER,
  AUDIT_NAME,
  BOOKING_URL,
  CONTACT_EMAIL,
  RETAINER_HEADLINE_ONE_LINER,
  RETAINER_NAME,
  SITE_URL,
  SPRINT_HEADLINE_ONE_LINER,
  SPRINT_NAME,
} from '../config';

const offers = [
  {
    name: 'Agent Reliability Review',
    bestFor:
      'Business owners who have already built or bought AI agents, workflows, or automations — and are not sure whether they still work.',
    includes: [
      '45-minute working call with whoever owns the workflows',
      'Diagnostic run against the four silent-failure modes (bad output on green status, dropped webhooks, stalled triggers, downstream data loss)',
      'Per-workflow findings with evidence and blast-radius numbers',
      'Remediation plan with hours-of-effort per fix',
      'Monitoring posture recommendation so the next failure is caught before your customer notices',
      '30-minute review call',
    ],
    outcome:
      'A clear answer to "is what you already built actually working?" with a remediation plan and a monitoring posture.',
  },
  {
    name: 'Agent Implementation Sprint',
    bestFor:
      'Businesses ready to put one painful workflow into production, with testing, guardrails, and a documented handover.',
    includes: [
      'First-operator design',
      'Agent and runtime configuration',
      'Auth and integration setup',
      'Testing with live examples',
      'Guardrails and escalation paths',
      'SOP and handoff notes',
      'Training session',
    ],
    outcome:
      'One workflow becomes measurably faster and less owner-dependent, with a baseline to measure it against.',
  },
  {
    name: 'Fractional AI Officer',
    bestFor: 'Teams that want the capacity of one junior engineering hire on AI operations, without the hire — roughly one junior FTE without the salary, benefits, or onboarding cost. We do AgentOps for firms that don\'t have engineers.',
    includes: [
      'One to two active requests at a time',
      'Under-48-hour turnaround target',
      'Monitoring and failure alerts',
      'Maintenance and tuning',
      'New workflow rollout',
      'Customer-facing request queue',
      'Async video updates',
      'Continuous optimization',
    ],
    outcome:
      'AI adoption becomes a line in the operating budget with an owner attached, and a queue you can see into.',
  },
];

// Three explicit Service records — one per offer — with an OfferCatalog binding
// them for the /services/ page. Each Service carries a stable @id keyed to the
// canonical URL fragment for that offer, so cross-page references (from
// /ai-workflow-audit/, /method/, index, and fractional-AI-officer
// pages) can point at the same entity by @id instead of restating it.
const auditServiceId = `${SITE_URL}/services/#agent-reliability-review`;
const sprintServiceId = `${SITE_URL}/services/#agent-implementation-sprint`;
const retainerServiceId = `${SITE_URL}/services/#fractional-ai-officer`;

const auditService = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': auditServiceId,
  name: AUDIT_NAME,
  serviceType: 'AI workflow audit',
  description: AUDIT_HEADLINE_ONE_LINER,
  provider: { '@id': `${SITE_URL}/#organization` },
  areaServed: { '@type': 'Country', name: 'United States' },
  audience: {
    '@type': 'BusinessAudience',
    name: 'Owner-led businesses with 5 to 50 employees',
  },
  url: `${SITE_URL}/services/`,
};

const sprintService = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': sprintServiceId,
  name: SPRINT_NAME,
  serviceType: 'AI agent implementation',
  description: SPRINT_HEADLINE_ONE_LINER,
  provider: { '@id': `${SITE_URL}/#organization` },
  areaServed: { '@type': 'Country', name: 'United States' },
  audience: {
    '@type': 'BusinessAudience',
    name: 'Owner-led businesses with 5 to 50 employees',
  },
  url: `${SITE_URL}/services/`,
};

const retainerService = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': retainerServiceId,
  name: RETAINER_NAME,
  serviceType: 'Managed AI operations',
  description: RETAINER_HEADLINE_ONE_LINER,
  provider: { '@id': `${SITE_URL}/#organization` },
  areaServed: { '@type': 'Country', name: 'United States' },
  audience: {
    '@type': 'BusinessAudience',
    name: 'Owner-led businesses with 5 to 50 employees',
  },
  url: `${SITE_URL}/services/`,
};

const serviceList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Phronimos services',
  url: `${SITE_URL}/services/`,
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      item: { '@id': auditServiceId },
    },
    {
      '@type': 'ListItem',
      position: 2,
      item: { '@id': sprintServiceId },
    },
    {
      '@type': 'ListItem',
      position: 3,
      item: { '@id': retainerServiceId },
    },
  ],
};

const jsonLd = [auditService, sprintService, retainerService, serviceList];
---

<BaseLayout
  title="AI Agent Services | Phronimos"
  description="Agent Reliability Reviews, AI agent implementation sprints, and managed AI operations for owner-led businesses."
  jsonLd={jsonLd}
>
  <section class="section-tight page-head">
    <div class="container">
      <hr class="rule" data-reveal />
      <h1 data-reveal style="--reveal-i: 1">AI agent services</h1>
      <p class="lede answer" data-reveal style="--reveal-i: 2">
        <strong>Three engagements. One controlled path.</strong> An {AUDIT_NAME} finds the
        bottleneck and scopes the build. An Agent Implementation Sprint puts the first agent into
        production. The Fractional AI Officer retainer keeps it running and adds the next one.
      </p>
      <p class="muted scope-rule" data-reveal style="--reveal-i: 3">
        Each engagement is scoped in writing before it starts. If the scope changes during the
        work, we agree on the change before continuing.
      </p>
      <p class="muted head-links" data-reveal style="--reveal-i: 4">
        More detail: <a href="/ai-workflow-audit/">what the audit includes</a> &middot;
        <a href="/security/">how we handle system access</a> &middot;
        <a href="/faq/">scope and ownership questions</a>
      </p>
    </div>
  </section>

  {
    offers.map((offer, i) => (
      <section class={`section offer-section ${i % 2 ? 'offer-alt' : ''}`}>
        <div class="container offer-grid">
          <div class="offer-lead" data-reveal>
            <h2>{offer.name}</h2>
            <p class="best-for muted">
              <strong>Best for:</strong> {offer.bestFor}
            </p>
          </div>
          <div class="offer-detail" data-reveal style="--reveal-i: 1">
            <h3 class="list-head">Included</h3>
            <ul class="include-list">
              {offer.includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <div class="callout">
              <p class="outcome-head">Outcome</p>
              <p>{offer.outcome}</p>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class="section-tight roi">
    <div class="container">
      <h2 data-reveal>How do you measure the return on an AI agent?</h2>
      <p class="lede answer" data-reveal style="--reveal-i: 1">
        Every operator ships with a baseline taken before it goes live, then a monthly report:
        volume handled, escalation rate, first-pass accuracy against sampled review, and cycle time
        against that starting baseline.
      </p>
      <p class="muted" data-reveal style="--reveal-i: 2">
        The audit sets the first baseline by estimating hours lost per week and what they cost. From
        the sprint onward, every claim about value traces to a number that existed before we
        touched anything.
      </p>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container">
      <h2 class="display" data-reveal>The audit is the front door.</h2>
      <p class="lede" data-reveal style="--reveal-i: 1">
        A bounded first step with a concrete deliverable, and the scoping document for everything
        that follows.
      </p>
      <div class="cta-actions" data-reveal style="--reveal-i: 2">
        <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Book the {AUDIT_NAME}</a>
        <span class="muted">or write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head h1 {
    margin-top: var(--space-6);
    max-width: 22ch;
  }

  .page-head .lede {
    margin-top: var(--space-5);
    max-width: 62ch;
  }

  .scope-rule {
    margin-top: var(--space-5);
    max-width: 56ch;
    font-size: 15.5px;
  }

  /* The credit is the whole reason a low front-door fee reads as a qualifying
     step rather than the ceiling on the practice. Give it its own weight. */
  .credit-note {
    margin-top: var(--space-4);
    max-width: 60ch;
    font-size: 15.5px;
    padding-left: var(--space-4);
    border-left: 2px solid var(--accent-solid);
  }

  .head-links {
    margin-top: var(--space-5);
    font-size: 15.5px;
  }

  .answer {
    max-width: 64ch;
  }

  .roi .muted {
    margin-top: var(--space-5);
    max-width: 62ch;
    font-size: 15.5px;
  }

  .offer-section {
    border-top: 1px solid var(--line);
  }

  .offer-alt {
    background: var(--surface-raised);
  }

  .offer-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .best-for {
    margin-top: var(--space-4);
    font-size: 16px;
  }

  .list-head {
    font-size: 16px;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .include-list {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
    columns: 2;
    column-gap: var(--space-6);
  }

  .include-list li {
    break-inside: avoid;
    padding-block: var(--space-2);
    font-size: 16px;
  }

  .offer-detail .callout {
    margin-top: var(--space-6);
  }

  .outcome-head {
    font-family: var(--font-tight);
    font-weight: 500;
    color: var(--accent-strong);
    font-size: 15px;
  }

  .callout p + p {
    margin-top: var(--space-2);
    font-size: 15.5px;
  }

  .roi .lede {
    margin-top: var(--space-4);
    max-width: 62ch;
  }

  .final-cta .display {
    max-width: 16ch;
  }

  .final-cta .lede {
    margin-top: var(--space-5);
    max-width: 52ch;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-7);
  }

  @media (max-width: 860px) {
    .offer-grid {
      grid-template-columns: 1fr;
    }

    .include-list {
      columns: 1;
    }
  }
</style>
