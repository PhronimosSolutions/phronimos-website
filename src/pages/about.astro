---
import BaseLayout from '../layouts/BaseLayout.astro';
import Brandmark from '../components/Brandmark.astro';
import {
  AUDIT_NAME,
  BOOKING_URL,
  CONTACT_EMAIL,
  FOUNDER_JOB_TITLE,
  FOUNDER_KNOWS_ABOUT,
  FOUNDER_LINKEDIN,
  FOUNDER_NAME,
  RETAINER_NAME,
  SITE_URL,
  SPRINT_NAME,
} from '../config';

// Founder Person block. Uses the same @id the site-wide Organization already
// declares (BaseLayout emits Organization.founder with this @id), so this
// page's block resolves as the canonical Person record rather than a
// duplicate. The Person and Organization thereby cross-reference each other
// without either being restated.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE_URL}/about/#founder`,
  name: FOUNDER_NAME,
  jobTitle: FOUNDER_JOB_TITLE,
  worksFor: { '@id': `${SITE_URL}/#organization` },
  knowsAbout: FOUNDER_KNOWS_ABOUT,
  url: `${SITE_URL}/about/`,
  // TODO: fill FOUNDER_LINKEDIN in config.ts once the personal LinkedIn URL is confirmed.
  ...(FOUNDER_LINKEDIN ? { sameAs: [FOUNDER_LINKEDIN] } : {}),
};
---

<BaseLayout
  title="About Phronimos | Custom Managed AI Agents"
  description="Phronimos designs, builds, and runs custom AI agents for owner-led businesses. The name is Ancient Greek for practical wisdom, and it sets the standard."
  jsonLd={jsonLd}
>
  <section class="section-tight page-head">
    <div class="container">
      <hr class="rule" data-reveal />
      <h1 data-reveal style="--reveal-i: 1">About Phronimos</h1>
      <p class="lede" data-reveal style="--reveal-i: 2">
        <strong>Phronimos designs, builds, and runs custom AI agents for owner-led businesses.</strong>
        The bet behind the name is that judgment about which work to automate matters more than
        the technology used to automate it.
      </p>
    </div>
  </section>

  <section class="section name-story">
    <div class="container name-grid">
      <div class="mark-block" data-reveal>
        <Brandmark size={120} variant="dark" />
      </div>
      <div class="name-copy" data-reveal style="--reveal-i: 1">
        <h2>The name</h2>
        <p>
          Phronimos comes from the Ancient Greek <em>φρόνιμος</em>: prudent, practically wise,
          exercising sound judgment. It is the adjectival form of <em>phronesis</em>, Aristotle's
          word for practical wisdom. Knowing not just what is true, but what to do.
        </p>
        <p>
          The letter that opens the name, phi, is also the symbol of the golden ratio: the
          classical proportion associated with balance and sound structure. That is the brand's
          argument in a single glyph. Intelligence in the right proportion, applied with judgment.
        </p>
        <p class="muted pronounce">Pronounced FRAH-nih-mos.</p>
      </div>
    </div>
  </section>

  <section class="section services-summary" aria-labelledby="what-we-do">
    <div class="container">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">What Phronimos does</p>
        <h2 id="what-we-do">Diagnose, build, and run dependable AI operations.</h2>
      </div>
      <div class="service-list">
        <article data-reveal>
          <p class="service-index" aria-hidden="true">01</p>
          <div>
            <h3>{AUDIT_NAME}</h3>
            <p>
              A fixed-fee diagnostic for agents and automations already in use. It finds silent
              failures, documents evidence, and produces a prioritized remediation plan.
            </p>
          </div>
        </article>
        <article data-reveal style="--reveal-i: 1">
          <p class="service-index" aria-hidden="true">02</p>
          <div>
            <h3>{SPRINT_NAME}</h3>
            <p>
              One painful workflow is designed, integrated, tested, and put into production with
              guardrails, monitoring, and a documented handover.
            </p>
          </div>
        </article>
        <article data-reveal style="--reveal-i: 2">
          <p class="service-index" aria-hidden="true">03</p>
          <div>
            <h3>{RETAINER_NAME}</h3>
            <p>
              Ongoing ownership for the systems that stay live: monitoring, incident response,
              maintenance, measured improvement, and the next workflow in the queue.
            </p>
          </div>
        </article>
      </div>
      <p class="section-link" data-reveal><a href="/services/">Compare services and deliverables</a></p>
    </div>
  </section>

  <section class="section why">
    <div class="container why-inner">
      <h2 data-reveal>Why Phronimos exists</h2>
      <div class="prose" data-reveal style="--reveal-i: 1">
        <p>
          Phronimos was founded on a simple conviction: most businesses are full of capable people
          spending their days on work that is repetitive, mechanical, or purely mechanical
          coordination. The opportunity is to design durable solutions to those operational
          problems, so owners and their teams get their attention back for work that needs a person.
        </p>
        <p>
          That motivation sets the center of gravity. The interesting object here is the problem:
          the bottleneck, the handoff that keeps failing, the task that quietly consumes a day a
          week. The technology is whatever turns out to solve it, and a simpler answer usually wins.
        </p>
        <p>
          This is why the work values judgment over novelty and reliability over hype. The measure
          is whether the business runs better six months later.
        </p>
      </div>
    </div>
  </section>

  <section class="section principles">
    <div class="container">
      <h2 data-reveal>Operating principles</h2>
      <ul class="principles-grid">
        <li data-reveal>
          <h3>Practical wisdom first.</h3>
          <p class="muted">
            Every system is judged by the quality of its decisions. If a simpler approach produces
            a better result, that is the more intelligent approach.
          </p>
        </li>
        <li data-reveal style="--reveal-i: 1">
          <h3>Reliability is the product.</h3>
          <p class="muted">
            An agent that only works most of the time can cost more attention than it saves, since
            somebody has to check it. We optimize for consistent, supervisable execution.
          </p>
        </li>
        <li data-reveal style="--reveal-i: 2">
          <h3>Solve the business problem.</h3>
          <p class="muted">
            Start from the bottleneck and work backward. Whether the answer turns out to be an
            agent, a rewritten process, or one fewer meeting is an outcome of the diagnosis.
          </p>
        </li>
        <li data-reveal style="--reveal-i: 3">
          <h3>Capacity, not headcount math.</h3>
          <p class="muted">
            Success looks like a team taking on work it could not previously absorb, while leaving a human in the loop for the work that only humans can do well.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section staffing">
    <div class="container staffing-inner">
      <h2 data-reveal>How engagements are staffed</h2>
      <div class="prose" data-reveal style="--reveal-i: 1">
        <p>
          Every Phronimos engagement runs end to end with the same specialist: the review call, the
          build, and the monitoring afterward. There is no handoff between the person who scopes the
          work and the person who does it.
        </p>
        <p>
          That is why the practice deliberately holds one or two active builds at a time. Capacity is
          the constraint that protects the quality, and it is the reason the pattern that makes
          buyers wary of this category, where a senior person sells and a junior person delivers,
          has nowhere to happen here.
        </p>
        <p>
          The monitoring, failure alerts, and documented playbooks that ship with every client
          operator also run the Phronimos delivery pipeline. The discipline sold to our clients is the same 
          discipline the Phronimos runs on.
        </p>
        <p class="staffing-links">
          Questions about how an engagement runs? Write to{' '}
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>, or read{' '}
          <a href="/security/">how system access is handled</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section founder" aria-labelledby="team-heading">
    <div class="container founder-grid">
      <div data-reveal>
        <p class="eyebrow">The team behind Phronimos</p>
        <h2 id="team-heading">Founder-led by design.</h2>
      </div>
      <div class="prose" data-reveal style="--reveal-i: 1">
        <p>
          <strong>{FOUNDER_NAME}</strong> founded Phronimos after leading support and AI automation
          work inside SaaS organizations. His operating background spans customer operations,
          workflow design, and the practical work of putting AI systems into production.
        </p>
        <p>
          Phronimos is a small specialist practice, not an agency layer. Matthew scopes the work,
          builds the system, and remains accountable after launch.
        </p>
      </div>
    </div>
  </section>

  <section class="section audience" aria-labelledby="audience-heading">
    <div class="container split-section">
      <div data-reveal>
        <p class="eyebrow">Who uses Phronimos</p>
        <h2 id="audience-heading">Built for owner-led teams with real operational drag.</h2>
      </div>
      <ul class="audience-list" data-reveal style="--reveal-i: 1">
        <li>Owner-led businesses with roughly 5–50 employees.</li>
        <li>Teams with agents or automations in production but no clear operational owner.</li>
        <li>Firms with a specific, repeated workflow that consumes skilled staff time.</li>
        <li>Leaders who need evidence, guardrails, and accountability—not another AI demo.</li>
      </ul>
    </div>
  </section>

  <section class="section facts" aria-labelledby="facts-heading">
    <div class="container facts-grid">
      <div data-reveal>
        <p class="eyebrow">Key facts</p>
        <h2 id="facts-heading">Phronimos at a glance.</h2>
      </div>
      <dl class="fact-list" data-reveal style="--reveal-i: 1">
        <div><dt>Company</dt><dd>Phronimos</dd></div>
        <div><dt>Type</dt><dd>Founder-led AI operations consultancy</dd></div>
        <div><dt>Founder</dt><dd>{FOUNDER_NAME}</dd></div>
        <div><dt>Headquarters</dt><dd>San Diego, California</dd></div>
        <div><dt>Website</dt><dd><a href={SITE_URL}>phronimos.io</a></dd></div>
        <div><dt>Core offering</dt><dd>Managed AI agents and reliability operations</dd></div>
        <div><dt>Contract terms</dt><dd>Fixed-fee projects; managed service is month to month with 30 days' notice</dd></div>
        <div><dt>Communication</dt><dd>Direct access to the practitioner doing the work</dd></div>
        <div><dt>Service area</dt><dd>United States</dd></div>
      </dl>
    </div>
  </section>

  <section class="section faq" aria-labelledby="faq-heading">
    <div class="container">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Frequently asked questions</p>
        <h2 id="faq-heading">The useful questions, answered plainly.</h2>
      </div>
      <div class="faq-list">
        <article data-reveal>
          <h3>Does Phronimos sell an AI software platform?</h3>
          <p>No. Phronimos is a managed service. The work starts with the operating problem, uses the tools that fit it, and leaves the client with a documented system rather than another platform to administer.</p>
        </article>
        <article data-reveal>
          <h3>Who will I work with?</h3>
          <p>You work directly with founder Matthew Kirby from diagnosis through implementation and ongoing operations. There is no sales-to-delivery handoff.</p>
        </article>
        <article data-reveal>
          <h3>How does an engagement start?</h3>
          <p>Most work starts with the {AUDIT_NAME}. It establishes the current state, identifies the highest-value failure or bottleneck, and defines the smallest responsible next step.</p>
        </article>
        <article data-reveal>
          <h3>Will Phronimos replace our team?</h3>
          <p>No. The aim is to remove repetitive coordination and fragile manual work so the existing team can spend more time on judgment, relationships, and exceptions.</p>
        </article>
      </div>
      <p class="section-link" data-reveal><a href="/faq/">Read all frequently asked questions</a></p>
    </div>
  </section>

  <section class="section-tight honest">
    <div class="container">
      <h2 data-reveal>Who Phronimos is a poor fit for</h2>
      <ul class="honest-list">
        <li data-reveal>
          <p>
            Businesses looking for the cheapest possible automation. A single Zapier consultant will
            cost less and may be the right call.
          </p>
        </li>
        <li data-reveal style="--reveal-i: 1">
          <p>
            Teams whose core records live in systems nobody can export from. Agents need reliable
            inputs, and the review will say so plainly if yours are not there yet.
          </p>
        </li>
        <li data-reveal style="--reveal-i: 2">
          <p>
            Companies wanting one large system built and then handed over with no ongoing
            relationship. That model exists elsewhere and is honestly served elsewhere.
          </p>
        </li>
      </ul>
      <p class="muted honest-note" data-reveal>
        The review ends in a verdict, and sometimes the verdict is that the timing is wrong. That
        answer is worth the fee too.
      </p>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container">
      <h2 class="display" data-reveal>See it applied to your operations.</h2>
      <div class="cta-actions" data-reveal style="--reveal-i: 1">
        <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Book the {AUDIT_NAME}</a>
        <span class="muted">or write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head h1 {
    margin-top: var(--space-6);
    max-width: 24ch;
  }

  .name-grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .mark-block {
    display: flex;
    justify-content: center;
    padding-top: var(--space-3);
  }

  .name-copy p {
    margin-top: var(--space-4);
    max-width: 62ch;
  }

  .pronounce {
    font-size: 15px;
  }

  .why {
    border-top: 1px solid var(--line);
    background: var(--surface-raised);
  }

  .services-summary,
  .audience,
  .faq {
    border-top: 1px solid var(--line);
  }

  .section-intro,
  .split-section,
  .founder-grid,
  .facts-grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(32px, 7vw, 112px);
    align-items: start;
  }

  .eyebrow {
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .service-list {
    margin-top: var(--space-8);
    border-top: 1px solid var(--line);
  }

  .service-list article {
    display: grid;
    grid-template-columns: minmax(44px, 1fr) minmax(0, 11fr);
    gap: var(--space-5);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--line);
  }

  .service-list h3,
  .faq-list h3 {
    font-size: 1.2rem;
  }

  .service-list article p:last-child,
  .faq-list p {
    max-width: 64ch;
    margin-top: var(--space-2);
    color: var(--text-muted);
  }

  .service-index {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .section-link {
    margin-top: var(--space-6);
  }

  .why-inner .prose {
    margin-top: var(--space-5);
  }

  .principles-grid {
    list-style: none;
    padding: 0;
    margin: var(--space-7) 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7) var(--space-8);
  }

  .principles-grid h3 {
    font-size: 19px;
  }

  .principles-grid .muted {
    margin-top: var(--space-2);
    font-size: 15.5px;
    max-width: 46ch;
  }

  .staffing {
    border-top: 1px solid var(--line);
  }

  .founder,
  .facts {
    border-top: 1px solid var(--line);
    background: var(--surface-raised);
  }

  .audience-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .audience-list li {
    padding: var(--space-4) 0 var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--line);
    position: relative;
  }

  .audience-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .fact-list {
    margin: 0;
  }

  .fact-list > div {
    display: grid;
    grid-template-columns: minmax(120px, 1fr) minmax(0, 2fr);
    gap: var(--space-5);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--line);
  }

  .fact-list dt {
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  .fact-list dd {
    margin: 0;
  }

  .faq-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7) var(--space-8);
    margin-top: var(--space-8);
  }

  .staffing-inner .prose {
    margin-top: var(--space-5);
  }

  .staffing-links {
    margin-top: var(--space-5);
    font-size: 15.5px;
  }

  /* Naming a poor fit is a premium signal, and the only one available before
     there are case studies. Kept plain on purpose. */
  .honest {
    border-top: 1px solid var(--line);
    background: var(--surface-raised);
  }

  .honest-list {
    list-style: none;
    padding: 0;
    margin: var(--space-6) 0 0;
    border-top: 1px solid var(--line);
    max-width: 72ch;
  }

  .honest-list li {
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--line);
  }

  .honest-list p {
    max-width: 64ch;
  }

  .honest-note {
    margin-top: var(--space-5);
    max-width: 56ch;
    font-size: 15.5px;
  }

  .final-cta .display {
    max-width: 18ch;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-7);
  }

  @media (max-width: 860px) {
    .name-grid,
    .principles-grid,
    .section-intro,
    .split-section,
    .founder-grid,
    .facts-grid,
    .faq-list {
      grid-template-columns: 1fr;
    }

    .mark-block {
      justify-content: flex-start;
    }
  }
</style>
