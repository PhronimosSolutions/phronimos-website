---
import { SITE_NAME, SITE_URL } from '../config';

interface Props {
  title: string;
  description: string;
  /** Page-specific JSON-LD object(s); rendered as-is. */
  jsonLd?: object | object[];
  ogType?: string;
}

const { title, description, jsonLd, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL('/og/og-default.png', SITE_URL).href;
const blocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Escape "<" as "\u003c" so a string value containing "</script>" can never
// terminate the JSON-LD block early; the escaped form parses identically.
const toJsonLd = (block: object) => JSON.stringify(block).replace(/</g, '\\u003c');
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{blocks.map((block) => <script type="application/ld+json" set:html={toJsonLd(block)} />)}
