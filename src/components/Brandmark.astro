---
// The Phronimos hexagonal "P" brandmark (Phronimos_logo1) — mark only, no wordmark.
// Inline for crisp rendering and CSS-drivable color.
// variant "light" = for light surfaces (charcoal mark)
// variant "dark"  = for dark surfaces (off-white mark)
interface Props {
  variant?: 'light' | 'dark';
  size?: number;
  class?: string;
}
const { variant = 'light', size = 34, class: className } = Astro.props;
const color = variant === 'dark' ? '#F5F7F8' : '#232B32';
// Native artwork aspect ratio (119.13 × 137.6).
const height = Math.round(size * (137.6 / 119.13));
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 119.13 137.6"
  width={size}
  height={height}
  role="img"
  aria-label="Phronimos"
  fill={color}
  class={className}
>
  <path
    d="M62.76,136.6c-2.51,1.47-5.59,1.31-7.86-.46L2.05,105.09c-.79-.84-2.04-2.97-2.04-4.11v-63.7c-.01-1.97,1.55-4.16,3.24-5.17L54.37,1.68c3.59-2.14,7.03-2.41,10.57.24l50.3,29.7c1.98,1.17,3.89,3.14,3.89,5.65l-.02,63.05c0,2.89-2.24,4.51-4.47,5.82l-51.88,30.47ZM53.57,68.47l.47,57.82c1.39,1.58,3.46,2.73,5.67,3.1l51.82-30.5-.07-60.72L59.31,7.55,7.42,38.56l.05,60.77,21.36,12.6v-57.8l24.74,14.34Z"
  ></path>
  <polygon points="59.31 65.45 32.78 49.77 59.44 33.63 86.86 49.23 59.31 65.45"></polygon>
  <polygon points="59.82 110.5 59.56 93.18 69.53 87.31 69.54 65.65 89.54 54.04 89.7 92.94 59.82 110.5"
  ></polygon>
</svg>
