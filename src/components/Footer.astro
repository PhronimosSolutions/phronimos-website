---
import PhiMark from './PhiMark.astro';
import { CONTACT_EMAIL, LEGAL_NAME, TAGLINE } from '../config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="brand" aria-label="Phronimos home">
          <PhiMark size={24} />
          <span class="wordmark">Phronimos</span>
        </a>
        <p class="muted tagline">{TAGLINE}.</p>
      </div>

      <nav class="footer-col" aria-label="Site">
        <h2 class="footer-head">Site</h2>
        <a href="/method/">Method</a>
        <a href="/services/">Services</a>
        <a href="/assessment/">Assessment</a>
        <a href="/notes/">Notes</a>
        <a href="/about/">About</a>
        <a href="/faq/">FAQ</a>
      </nav>

      <div class="footer-col">
        <h2 class="footer-head">Contact</h2>
        <a href="/contact/">Book the Audit</a>
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </div>
    </div>

    <div class="footer-legal">
      <span>{year} {LEGAL_NAME}. All rights reserved.</span>
      <span class="legal-links">
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: var(--space-8) var(--space-6);
    background: var(--surface-canvas);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-7);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .wordmark {
    font-family: var(--font-tight);
    font-weight: 500;
    font-size: 19px;
    letter-spacing: 0.04em;
  }

  .tagline {
    margin-top: var(--space-3);
    font-size: 15px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-head {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: var(--space-2);
  }

  .footer-col a {
    text-decoration: none;
    font-size: 15.5px;
    color: var(--text-secondary);
    transition: color var(--dur-transition) var(--ease-precise);
  }

  .footer-col a:hover {
    color: var(--text-primary);
  }

  .footer-legal {
    display: flex;
    justify-content: space-between;
    gap: var(--space-5);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    font-size: 14px;
    color: var(--text-secondary);
  }

  .legal-links {
    display: inline-flex;
    gap: var(--space-5);
  }

  .legal-links a {
    color: inherit;
    text-decoration: none;
  }

  .legal-links a:hover {
    color: var(--text-primary);
  }

  @media (max-width: 767px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .footer-legal {
      flex-direction: column;
      gap: var(--space-2);
    }
  }
</style>
