---
import PhiMark from './PhiMark.astro';
import { BOOKING_URL } from '../config';

const links = [
  { href: '/method/', label: 'Method' },
  { href: '/services/', label: 'Services' },
  { href: '/assessment/', label: 'Assessment' },
  { href: '/notes/', label: 'Notes' },
  { href: '/about/', label: 'About' },
];
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Phronimos home">
      <PhiMark size={26} />
      <span class="wordmark">Phronimos</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      {
        links.map(({ href, label }) => (
          <a href={href} aria-current={current === href ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
    </nav>

    <a href={BOOKING_URL} class="btn btn-primary header-cta">Book the Audit</a>

    <details class="mobile-nav">
      <summary aria-label="Menu">
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
      </summary>
      <nav aria-label="Primary mobile">
        {links.map(({ href, label }) => <a href={href}>{label}</a>)}
        <a href={BOOKING_URL} class="btn btn-primary">Book the Audit</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--surface-canvas) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: 68px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
  }

  .wordmark {
    font-family: var(--font-tight);
    font-weight: 500;
    font-size: 20px;
    letter-spacing: 0.04em;
  }

  .desktop-nav {
    display: flex;
    gap: var(--space-6);
    margin-left: auto;
  }

  .desktop-nav a {
    text-decoration: none;
    font-size: 15.5px;
    color: var(--text-secondary);
    transition: color var(--dur-transition) var(--ease-precise);
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current='page'] {
    color: var(--text-primary);
  }

  .header-cta {
    padding: 10px 22px;
    font-size: 15px;
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 860px) {
    .desktop-nav,
    .header-cta {
      display: none;
    }

    .mobile-nav {
      display: block;
      margin-left: auto;
      position: relative;
    }

    .mobile-nav summary {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 12px 4px;
      cursor: pointer;
    }

    .mobile-nav summary::-webkit-details-marker {
      display: none;
    }

    .menu-bar {
      width: 24px;
      height: 2px;
      background: var(--text-primary);
      transition: transform var(--dur-transition) var(--ease-precise);
    }

    .mobile-nav[open] .menu-bar:first-child {
      transform: translateY(4px) rotate(45deg);
    }

    .mobile-nav[open] .menu-bar:last-child {
      transform: translateY(-4px) rotate(-45deg);
    }

    .mobile-nav nav {
      position: absolute;
      right: 0;
      top: calc(100% + 10px);
      min-width: 220px;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding: var(--space-5);
      background: var(--surface-raised);
      border: 1px solid var(--line);
      border-radius: var(--radius-card);
      box-shadow: var(--shadow-card);
    }

    .mobile-nav nav a {
      text-decoration: none;
      font-size: 16px;
    }
  }
</style>
