---
import BaseLayout from './BaseLayout.astro';
import { SITE_URL } from '../config';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  slug: string;
}

const { title, description, pubDate, updatedDate, slug } = Astro.props;
const dateModified = (updatedDate ?? pubDate).toISOString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified,
    author: { '@id': `${SITE_URL}/#organization` },
    publisher: { '@id': `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/notes/${slug}/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Notes', item: `${SITE_URL}/notes/` },
      {
        '@type': 'ListItem',
        position: 3,
        name: title,
        item: `${SITE_URL}/notes/${slug}/`,
      },
    ],
  },
];

const dateLabel = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={`${title} | Phronimos`} description={description} jsonLd={jsonLd} ogType="article">
  <article class="section post">
    <div class="container">
      <header class="post-head">
        <p class="muted"><a href="/notes/">Notes</a> &middot; <time datetime={pubDate.toISOString()}>{dateLabel}</time></p>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        <hr class="rule" />
      </header>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post-head {
    max-width: 70ch;
  }

  .post-head h1 {
    margin-top: var(--space-4);
    max-width: 24ch;
  }

  .post-head .lede {
    margin-top: var(--space-4);
  }

  .post-head .rule {
    margin-top: var(--space-6);
  }

  .post .prose {
    margin-top: var(--space-7);
  }

  .post-head a {
    color: var(--text-secondary);
  }
</style>
