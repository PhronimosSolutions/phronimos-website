---
import '../styles/base.css';
import '../styles/components.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  jsonLd?: object | object[];
  ogType?: string;
}

const { title, description, jsonLd, ogType } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Mark JS availability immediately so scroll-reveal styles only apply when
      // the observer will actually run. No JS: everything stays visible.
      document.documentElement.classList.add('js');
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Phronimos Notes" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} jsonLd={jsonLd} ogType={ogType} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal-on-scroll: adds .revealed once per element as it enters the viewport.
      // Elements already in the initial viewport reveal immediately (still animated,
      // but never dependent on observer timing); the rest reveal on scroll.
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = Array.from(document.querySelectorAll('[data-reveal]'));
      if (prefersReduced || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('revealed'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -36px 0px' }
        );
        for (const el of targets) {
          if (el.getBoundingClientRect().top < window.innerHeight) {
            // Synchronous: above-fold content must never depend on observer
            // or rAF timing to become visible.
            el.classList.add('revealed');
          } else {
            io.observe(el);
          }
        }
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 12px 20px;
        background: var(--surface-raised);
        border-radius: 0 0 12px 0;
      }

      .skip-link:focus {
        left: 0;
      }
    </style>
  </body>
</html>
