---
import '../styles/base.css';
import '../styles/components.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CONTACT_EMAIL, LEGAL_NAME, ORG_SAME_AS, SITE_NAME, SITE_URL } from '../config';

interface Props {
  title: string;
  description: string;
  jsonLd?: object | object[];
  ogType?: string;
}

const { title, description, jsonLd, ogType } = Astro.props;

// Site-wide entity graph. Emitted on every page with stable @ids so page-level
// blocks (FAQPage, Service, Article) can reference the organization by @id
// instead of restating it. For a brand with no search history this is the
// machine-readable answer to "what is Phronimos, and what does it sell."
//
// No Person entity and no postal address: the practice is deliberately not
// publishing individual identity. Entity resolution therefore rests entirely on
// ORG_SAME_AS, which makes filling that array more important, not less.
const organization = {
  '@type': 'ProfessionalService',
  '@id': `${SITE_URL}/#organization`,
  name: SITE_NAME,
  legalName: LEGAL_NAME,
  url: SITE_URL,
  email: CONTACT_EMAIL,
  logo: `${SITE_URL}/apple-touch-icon.png`,
  image: `${SITE_URL}/og/og-default.png`,
  description:
    'Phronimos designs, builds, and manages custom AI agents for owner-led businesses, starting with a paid AI workflow audit.',
  priceRange: '$$$',
  areaServed: { '@type': 'Country', name: 'United States' },
  knowsAbout: [
    'AI workflow audit',
    'AI agent implementation',
    'managed AI agents',
    'business process automation',
  ],
  ...(ORG_SAME_AS.length ? { sameAs: ORG_SAME_AS } : {}),
};

const website = {
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  url: SITE_URL,
  name: SITE_NAME,
  publisher: { '@id': `${SITE_URL}/#organization` },
};

const siteGraph = {
  '@context': 'https://schema.org',
  '@graph': [organization, website],
};

const pageBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allJsonLd = [siteGraph, ...pageBlocks];
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-C5TH0G8W8J"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-C5TH0G8W8J');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Mark JS availability immediately so scroll-reveal styles only apply when
      // the observer will actually run. No JS: everything stays visible.
      document.documentElement.classList.add('js');
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Phronimos Notes" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} jsonLd={allJsonLd} ogType={ogType} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal-on-scroll: adds .revealed once per element as it enters the viewport.
      // Elements already in the initial viewport reveal immediately (still animated,
      // but never dependent on observer timing); the rest reveal on scroll.
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = Array.from(document.querySelectorAll('[data-reveal]'));
      if (prefersReduced || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('revealed'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -36px 0px' }
        );
        for (const el of targets) {
          if (el.getBoundingClientRect().top < window.innerHeight) {
            // Synchronous: above-fold content must never depend on observer
            // or rAF timing to become visible.
            el.classList.add('revealed');
          } else {
            io.observe(el);
          }
        }
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 12px 20px;
        background: var(--surface-raised);
        border-radius: 0 0 12px 0;
      }

      .skip-link:focus {
        left: 0;
      }
    </style>
  </body>
</html>
