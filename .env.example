# Web3Forms access key. Get one at https://web3forms.com (free tier is fine).
# The contact form and the AI Maturity Assessment both submit through this key.
# Without it, both forms show a polite "email us instead" message.
PUBLIC_WEB3FORMS_KEY=WEB3FORMS_ACCESS_KEY_HERE

# Optional: a second Web3Forms key created with matthew@phronimos.io, used only by the
# discovery questionnaires at /q/<token>/. Without it they fall back to the key above.
PUBLIC_WEB3FORMS_DISCOVERY_KEY=

# Discovery questionnaires (see DEPLOY.md). The write token lives only in this local .env
# (used by scripts/questionnaire.mjs). The read token and repo are set in Vercel.
QUESTIONNAIRES_WRITE_TOKEN=
QUESTIONNAIRES_REPO=PhronimosSolutions/phronimos-questionnaires
QUESTIONNAIRES_READ_TOKEN=
